{
  "name": "npm-ci-demo",
  "version": "1.0.0",
  "description": "Sample Node.js application for CI/CD testing",
  "main": "src/index.js",
  "scripts": {
    "lint": "eslint src test",
    "test": "jest --coverage",
    "test:integration": "jest test/integration.test.js",
    "build": "node -e \"require('fs').mkdirSync('dist',{recursive:true}); require('fs').cpSync('src','dist',{recursive:true})\"",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jest": "^29.7.0"
  }
}
